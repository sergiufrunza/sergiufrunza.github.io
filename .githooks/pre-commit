#!/bin/sh
# Keeps the CV PDFs in sync with the page they are rendered from.
# Enabled with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -e

REPO="$(git rev-parse --show-toplevel)"

# Nothing that affects the CV was staged — leave the PDFs alone.
if ! git diff --cached --name-only | grep -qE '^(index\.html|style\.css|script\.js)$'; then
  exit 0
fi

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[ -x "$CHROME" ] || CHROME="$(command -v chromium || command -v google-chrome || true)"
if [ ! -x "$CHROME" ]; then
  echo "pre-commit: Chrome not found — committing without refreshing the CV PDFs." >&2
  exit 0
fi

echo "pre-commit: regenerating CV PDFs from index.html…"
sh "$REPO/make-cv.sh"
git add "$REPO/cv-sergiu-frunza-en.pdf" "$REPO/cv-sergiu-frunza-ro.pdf"
